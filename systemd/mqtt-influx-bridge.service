[Unit]
Description=MQTT to InfluxDB Bridge
After=network-online.target mosquitto.service docker.service
Wants=network-online.target

[Service]
Type=simple
User=anthony
EnvironmentFile=-/home/anthony/.config/homelab/mqtt-influx.env
ExecStart=/usr/bin/python3 -u /home/anthony/mqtt_to_influx.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
